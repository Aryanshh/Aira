# Application Environment
APP_ENV=development

# Database Connections
# For local host access:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aira
# For docker-compose network:
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:postgres@db:5432/aira

# Security & Secrets
JWT_SECRET=aira_development_jwt_secret_key_minimum_32_chars_long_1234567890
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_DOMAIN=
COOKIE_SECURE=false

# URLs & Origins
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/api/v1

# Notifications: Email (Resend or Sendgrid)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_placeholder_key
EMAIL_FROM=AIRA Care <care@aira.example.com>

# Notifications: SMS (Twilio or MSG91)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=AC_placeholder_sid
SMS_AUTH_TOKEN=placeholder_token
SMS_FROM=+1234567890

# Notifications: WhatsApp (Twilio)
WHATSAPP_PROVIDER=twilio
WHATSAPP_FROM=+14155238886

# Notifications: Web Push (VAPID)
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=dev_vapid_private_key_placeholder_123456789
VAPID_SUBJECT=mailto:care@aira.example.com

# Timing & Escalation
SOS_ACK_WINDOW_SECONDS=15
SOS_MAX_ROUNDS=3
SOS_DEDUPE_WINDOW_SECONDS=60
AUTO_SEED_ON_STARTUP=true
